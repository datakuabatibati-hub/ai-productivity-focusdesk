<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1220">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI PRODUCTIVITY"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCoach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#172033"
            android:padding="12dp"
            android:text="Coach: pilih satu tugas kecil untuk dikerjakan sekarang."
            android:textColor="#DDE7FF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SEKARANG"
            android:textColor="#8FA3BF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada tugas aktif"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mode: IDLE"
            android:textColor="#7DD3FC"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPresence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presence: -"
            android:textColor="#AAB7CB"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="TODAY'S 3"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTask1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1. Tugas paling penting"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <Button
            android:id="@+id/btnTask1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KERJAKAN TUGAS 1" />

        <EditText
            android:id="@+id/etTask2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2. Tugas penting kedua"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <Button
            android:id="@+id/btnTask2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KERJAKAN TUGAS 2" />

        <EditText
            android:id="@+id/etTask3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3. Tugas penting ketiga"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <Button
            android:id="@+id/btnTask3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KERJAKAN TUGAS 3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kategori tugas aktif"
            android:textColor="#AAB7CB" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="FOCUS METER"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hari ini: 00:00:00 / 04:00:00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressTarget"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="0" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Sesi: 0 | Away: 0 | Best: 00:00:00"
            android:textColor="#AAB7CB" />

        <TextView
            android:id="@+id/tvSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesi sekarang: 00:00:00"
            android:textColor="#AAB7CB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFocus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FOCUS" />

            <Button
                android:id="@+id/btnBreak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="BREAK" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="DONE" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="ADHD RESCUE"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDistraction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DISTRAKSI" />

            <Button
                android:id="@+id/btnStuck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="STUCK" />

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="CAPTURE" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Inbox ide: 0"
            android:textColor="#AAB7CB" />

        <Button
            android:id="@+id/btnInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUKA INBOX IDE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="REKAP &amp; AI"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIHAT REKAP HARI INI" />

        <Button
            android:id="@+id/btnChatGPT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANALISIS DI CHATGPT" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="PENGATURAN"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBotToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telegram Bot Token"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <EditText
            android:id="@+id/etChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telegram Chat ID"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <EditText
            android:id="@+id/etInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Scan kamera (detik), default 5"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <EditText
            android:id="@+id/etAwaySeconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Konfirmasi away (detik), default 20"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <EditText
            android:id="@+id/etAlertSeconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Garmin mengingatkan setelah away (detik), default 120"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <EditText
            android:id="@+id/etAutoBreakMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Auto-break setelah away (menit), default 10"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <EditText
            android:id="@+id/etTargetMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target fokus harian (menit), default 240"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#61708A" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIMPAN SEMUA" />

        <Button
            android:id="@+id/btnTestTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TES GARMIN / TELEGRAM" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingBottom="30dp"
            android:text="Siap. Pilih tugas, lalu tekan FOCUS."
            android:textColor="#7E8DA6"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
