<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI PRODUCTIVITY"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Focus • Voice Log • ADHD Rescue"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEKARANG"
                    android:textColor="@color/accent2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Belum ada tugas aktif"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Mode: IDLE"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPresence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Presence: -"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCoach"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/surface2"
                    android:padding="12dp"
                    android:text="Coach: pilih satu tugas kecil untuk dikerjakan sekarang."
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="CAPTURE SUARA"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Jangan pindah aplikasi. Ucapkan, simpan, lalu kembali ke tugas."
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureIdea"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="🎙  IDE\nPARKIR DULU"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceKinerja"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="🎙  KERJAAN\n→ GOOGLE SHEET"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/accent2"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvKinerjaStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kinerja: belum ada capture"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSyncQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sinkronisasi: 0 tertunda"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetrySync"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SYNC ULANG CATATAN TERTUNDA"
            android:textAllCaps="false"
            app:cornerRadius="14dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUS METER"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hari ini: 00:00:00 / 04:00:00"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressTarget"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="9dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/accent2" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sesi: 0 | Away: 0 | Best: 00:00:00"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sesi sekarang: 00:00:00"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFocus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FOCUS"
                        app:backgroundTint="@color/success"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="BREAK"
                        app:backgroundTint="@color/warning"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="DONE"
                        app:backgroundTint="@color/danger"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Quick sprint"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSprint10"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10m" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSprint25"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="25m" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSprint45"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="45m" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TODAY'S 3"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTask1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1. Tugas paling penting"
            android:singleLine="true"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTask1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KERJAKAN TUGAS 1" />

        <EditText
            android:id="@+id/etTask2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2. Tugas penting kedua"
            android:singleLine="true"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTask2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KERJAKAN TUGAS 2" />

        <EditText
            android:id="@+id/etTask3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3. Tugas penting ketiga"
            android:singleLine="true"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTask3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KERJAKAN TUGAS 3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kategori tugas aktif"
            android:textColor="@color/textSecondary" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ADHD RESCUE"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDistraction"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DISTRAKSI" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStuck"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="STUCK" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Inbox ide: 0"
            android:textColor="@color/textSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInbox"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUKA INBOX IDE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="REKAP &amp; AI"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSummary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIHAT REKAP HARI INI" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChatGPT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANALISIS DI CHATGPT"
            android:textAllCaps="false"
            app:backgroundTint="@color/accent"
            app:cornerRadius="14dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOOGLE SHEETS / GAS"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGasUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Web App URL .../exec"
                    android:inputType="textUri"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etGasApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="API key GAS"
                    android:inputType="textPassword"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestGas"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TES KONEKSI GOOGLE SHEET" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GARMIN / TELEGRAM &amp; FOCUS"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBotToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Telegram Bot Token"
                    android:inputType="textPassword"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etChatId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Telegram Chat ID"
                    android:inputType="text"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Scan kamera (detik), default 5"
                    android:inputType="number"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etAwaySeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Konfirmasi away (detik), default 20"
                    android:inputType="number"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etAlertSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Garmin alert setelah away (detik), default 120"
                    android:inputType="number"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etAutoBreakMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Auto-break setelah away (menit), default 10"
                    android:inputType="number"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <EditText
                    android:id="@+id/etTargetMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Target fokus harian (menit), default 240"
                    android:inputType="number"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SIMPAN PENGATURAN"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestTelegram"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TES GARMIN / TELEGRAM" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingBottom="30dp"
            android:text="Siap. Pilih satu tugas, lalu fokus."
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
